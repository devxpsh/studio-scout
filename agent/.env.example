# Option A (Recommended — Free Tier, No GCP Billing Required)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=False
GEMINI_MODEL=gemini-2.5-flash

# Parallel Search API (optional on Free Tier — falls back to Google Search grounding if omitted)
PARALLEL_API_KEY=your-parallel-api-key-here

# Option B (Optional — Paid GCP Vertex AI)
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1